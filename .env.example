# A1 — optional. If unset, LogLens uses the mock diagnoser (A0).
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=45000
# DIAGNOSE_MODE=auto
#   auto   = use OpenAI when key present, else mock
#   mock   = always mock
#   openai = always OpenAI (errors if no key / API fails)
