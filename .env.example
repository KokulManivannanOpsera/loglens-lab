# Optional compose / local overrides (copy to labs/loglens/.env — gitignored)
# Used by: docker compose up

SESSION_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DIAGNOSE_MODE=auto
# BRING mid — local Ollama (DIAGNOSE_MODE=ollama or auto without OpenAI key)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# D11 — Terraform (pass secrets as TF_VAR_* — never commit terraform.tfvars with keys)
# TF_VAR_session_secret=
# TF_VAR_openai_api_key=

# Host port for the UI (container listens on PORT=80 in compose)
WEB_PORT=8088

# If true, API fails diagnose when Python AI is down (no node-local fallback)
AI_SERVICE_REQUIRED=false

# D5 PaaS: set COOKIE_SECURE=true (or rely on NODE_ENV=production).
# Leave unset locally so http://localhost login works.
# COOKIE_SECURE=false

# D7 — History DB. Empty / unset = SQLite (server/data/loglens.db).
# With compose profile postgres (db published on host :5433):
#   DATABASE_URL=postgres://loglens:loglens@db:5432/loglens   # inside compose
#   DATABASE_URL=postgres://loglens:loglens@127.0.0.1:5433/loglens  # host → api
#   docker compose --profile postgres up --build
# DATABASE_URL=

# A4b — reserved; even if true, lab still does not call Jira/GitHub
# AGENT_EXECUTE_WRITES=false

# BRING — Slack Incoming Webhook (needs_review / diagnose_failed). Leave empty = no-op.
# SLACK_WEBHOOK_URL=

# BRING — Insights cost proxy ($ per openai diagnose run)
# COST_USD_PER_OPENAI_RUN=0.0002
