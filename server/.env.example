# =============================================================================
# LogLens server secrets / config  (D6)
# =============================================================================
# 1. Copy this file:  cp server/.env.example server/.env
# 2. Put real values only in server/.env
# 3. Never commit server/.env  (gitignored)
# 4. Never put OPENAI_API_KEY in the client or as VITE_*  (that ships to the browser)
# =============================================================================

# Required for real LLM diagnoses (leave empty to use mock / auto→mock)
OPENAI_API_KEY=

# Auth (D6/AUTH) — sign JWT session cookies. Use a long random string in real deploys.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=45000
# DIAGNOSE_MODE=auto
# COOKIE_SECURE=true
PORT=8091

# Microservices: Python AI brain (leave empty to use in-process Node diagnose)
# Local:  AI_SERVICE_URL=http://127.0.0.1:8092
# Compose sets http://ai:8092 automatically
# AI_SERVICE_URL=
# AI_SERVICE_REQUIRED=false
# AI_SERVICE_TIMEOUT_MS=60000

# DATA-0 — History & Insights SQLite path (default: server/data/loglens.db)
# SQLITE_PATH=

# A2b — RAG retrieval mode: hybrid (default) | keyword | vector
# RAG_MODE=hybrid
# Embeddings: auto (openai if key else local) | local | openai
# EMBEDDING_PROVIDER=auto
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_VECTORS_PATH=   # default server/data/rag-vectors.json
